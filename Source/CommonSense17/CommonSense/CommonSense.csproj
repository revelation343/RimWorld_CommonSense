<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 (Waylith / .NET 10 CoreCLR) build. Compiles the CommonSense16 sources unchanged against
       the 1.7 game assemblies and the 1.7 Harmony. Output: ../../../1.7/Assemblies/CommonSense.dll -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CommonSense</RootNamespace>
    <AssemblyName>CommonSense</AssemblyName>
    <Version>1.7.0</Version>
    <Company>avilmask</Company>
    <Product>CommonSense</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>..\..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0168;CS0219;CS8632</NoWarn>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">F:\Games\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">F:\Games\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\CommonSense16\CommonSense\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
